# Copy to .env (never commit real values). See HANDOFF.md for where each value comes from.

# ---------------- Web client (apps/web) — PUBLIC, embedded in the browser bundle ----------------
# URL of the authoritative multiplayer server (http(s)://host[:port]). Default: http://localhost:2567
VITE_MULTIPLAYER_URL=http://localhost:2567
# Optional: Supabase project URL and anon/publishable key (safe for browsers; RLS protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------- Multiplayer server (apps/server) — SECRET, server only ----------------
NODE_ENV=development
PORT=2567
HOST=0.0.0.0
# Random string >= 32 chars used to sign guest session tokens. REQUIRED in production.
SERVER_SECRET=
# Comma-separated browser origins allowed to call the API / open WebSockets.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# memory = local JSON snapshot in DATA_DIR (dev only); supabase = durable storage.
STORE=memory
DATA_DIR=./data
# Required when STORE=supabase. NEVER expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy symmetric JWT secret.
SUPABASE_JWT_SECRET=
# Optional tuning (defaults shown)
GUEST_TOKEN_TTL_DAYS=30
READY_TIMEOUT_MS=20000
ROOM_TTL_MS=900000
MAX_CONNECTIONS_PER_IP=12
GUEST_TOKENS_PER_MINUTE=10
